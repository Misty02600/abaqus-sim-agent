{
  "schema_version": "full-task-api-efficiency-cases-v1",
  "purpose": "Measure how often a realistic Abaqus task actually needs Catalog help, without requiring Catalog lookup for every API usage point.",
  "stages": [
    "geometry",
    "material_section",
    "assembly_region",
    "load_bc",
    "mesh",
    "postprocess"
  ],
