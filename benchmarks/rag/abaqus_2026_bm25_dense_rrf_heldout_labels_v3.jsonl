er-t-outputsect1"],"evidence_paraphrase":"参考节点上的 PCAV 与 CVOL 历史变量分别给出腔内表压和腔体体积，可直接检查变形膨胀过程中的压力—体积响应。","family_ids":["heldout-page-family-surface-cavity-coupling"]}],"rationale":"该输出是题目所述压力随腔体膨胀变化的直接观测证据。"}],"annotation":{"method":"direct_official_html","retrieval_assistance":[],"annotator_id":"codex-heldout-multidoc-direct-html","reviewer_id":null,"completed_at":"2026-09-03T17:38:59.0204069+08:00"}}
