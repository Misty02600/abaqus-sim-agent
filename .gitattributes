* text=auto eol=lf

# Frozen fixtures and evaluation evidence are bound to byte-level hashes.
benchmarks/** -text
tests/fixtures/** -text
docs/research/evidence/** -text

# Catalog manifests bind the original JSON/JSONL bytes.
src/abaqus_sim_agent/api_catalog/data/*.json -text whitespace=cr-at-eol
src/abaqus_sim_agent/api_catalog/data/*.jsonl -text whitespace=cr-at-eol
